[Unit]
Description=Claude-Brücke für Schlaue Antworten (HTTP -> tmux-Sitzungen)
After=network-online.target claude-alexa-session.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/claude-alexa/env
ExecStart=/usr/bin/python3 %h/claude-alexa/bridge.py
Restart=always
RestartSec=10
# Voice sessions run in a tmux server started by the bridge; a bridge restart
# must not end them
KillMode=process

[Install]
WantedBy=default.target
