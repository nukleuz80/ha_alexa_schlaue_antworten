[Unit]
Description=Claude Code Sitzung "alexa" in tmux (Sprachaufträge von Alexa)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/bin/tmux new-session -d -s alexa -x 220 -y 50 %h/claude-alexa/run_session.sh
ExecStop=/usr/bin/tmux kill-session -t alexa
RemainAfterExit=yes

[Install]
WantedBy=default.target
